# OpenRouter API Key (get free key at https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Model (OpenRouter format)
# Free options: mistralai/mistral-7b-instruct:free, google/gemma-2-9b-it:free
LLM_MODEL=mistralai/mistral-7b-instruct:free

# Embeddings Model (local, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG Parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5

# API Server
API_HOST=0.0.0.0
API_PORT=8000
