# OpenRouter API Key (get free key at https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Model (OpenRouter format)
LLM_MODEL=openrouter/free

EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG Parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5

# API Server
API_HOST=0.0.0.0
API_PORT=8000
